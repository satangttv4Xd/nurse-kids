{
  "name": "nurse-kids",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c magenta,cyan \"vite\" \"npm:server:watch\"",
    "dev:web": "vite",
    "server": "node server/index.ts",
    "server:watch": "node --watch-path=server server/index.ts",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "start": "node server/index.ts",
    "demo:seed": "node server/seed-demo.ts",
    "demo:clear": "node server/seed-demo.ts --clear",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:vercel": "npm run build && node scripts/build-vercel.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.6.1",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.67.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.4",
    "@types/babel__core": "^7.20.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "rolldown": "~1.2.14",
    "tailwindcss": "^4.3.4",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  }
}
