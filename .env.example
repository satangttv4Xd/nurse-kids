# คัดลอกเป็น .env แล้วแก้ค่า (ห้าม commit ไฟล์ .env)

# พอร์ตของ API server
PORT=3001

# PostgreSQL จริง — ไม่ตั้ง = ใช้ PGlite (PostgreSQL ในเครื่อง เก็บที่ database/data) สำหรับพัฒนา/ทดลองเท่านั้น
# DATABASE_URL=postgres://littlesteps:รหัสผ่าน@localhost:5432/littlesteps

# กุญแจสำหรับ session ของผู้ดูแล (สุ่มยาว ≥ 32 ตัว) — จำเป็นใน production
# JWT_SECRET=

# บัญชีผู้ดูแลระบบคนแรก (ใช้ครั้งเดียวตอนยังไม่มีผู้ใช้) — จำเป็นใน production
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# false = ไม่รับข้อมูลจากเกม (เช่น ก่อนได้รับอนุมัติจริยธรรม)
COLLECTION_ENABLED=true

# ระยะเวลาเก็บรักษาข้อมูล (วัน) ตามนโยบายโครงการ
RETENTION_DAYS=1825

# ถือว่า session ถูกละทิ้งเมื่อไม่มีความเคลื่อนไหวเกิน (นาที)
ABANDON_AFTER_MINUTES=30

# NODE_ENV=production
